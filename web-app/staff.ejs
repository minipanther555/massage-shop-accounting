<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script
      src="https://js-de.sentry-cdn.com/6604be417c099671b7ee6e98970c90d6.min.js"
      crossorigin="anonymous"
    ></script>
    <title>Massage Shop POS - Today Staff</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .admin-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
        }
        
        /* Mobile-friendly reorder controls */
        .mobile-reorder {
            display: none; /* Hidden by default, shown on mobile */
        }
        
        .mobile-reorder .btn {
            margin: 2px;
            padding: 8px 12px;
            font-size: 14px;
            min-width: 44px; /* Touch-friendly minimum size */
            min-height: 44px;
        }
        
        /* Hide mobile controls on desktop */
        @media (min-width: 768px) {
            .mobile-reorder {
                display: none !important;
            }
        }
        
        /* Show mobile controls on small screens */
        @media (max-width: 767px) {
            .mobile-reorder {
                display: block !important;
            }
            
            /* Make buttons more touch-friendly on mobile */
            .btn-small {
                min-width: 44px;
                min-height: 44px;
                font-size: 16px;
            }
        }

        .today-helper-grid,
        .day-off-grid {
            display: grid;
            gap: 10px;
        }

        .today-helper-row,
        .day-off-row {
            display: grid;
            grid-template-columns: minmax(120px, 1fr) auto auto auto;
            gap: 8px;
            align-items: center;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
        }

        .today-helper-row.is-added {
            opacity: 0.55;
            background: #f2f2f2;
        }

        .today-helper-commission {
            font-weight: 700;
            white-space: nowrap;
        }

        .today-helper-flag {
            color: #9a3412;
            font-weight: 700;
        }

        .helper-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .helper-collapse-btn,
        .helper-restore-btn {
            border: 0;
            border-radius: 8px;
            padding: 10px 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .helper-collapse-btn {
            background: #1f2937;
            color: #fff;
        }

        .helper-restore-btn {
            display: none;
            width: 100%;
            margin-bottom: 12px;
            background: #dbeafe;
            color: #1e3a8a;
            border: 1px solid #93c5fd;
        }

        body.helpers-collapsed .today-helper-section,
        body.helpers-collapsed .day-off-section {
            display: none !important;
        }

        body.helpers-collapsed .helper-restore-btn {
            display: block;
        }

        @media (max-width: 767px) {
            .today-helper-row,
            .day-off-row {
                grid-template-columns: 1fr;
            }

            .helper-section-header {
                align-items: stretch;
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="nav-header staff-page-title">
            <span class="label-th">จัดคิวพนักงานวันนี้</span>
            <span class="label-en helper-text">Today Staff</span>
        </div>

        <div class="nav-buttons staff-page-nav">
            <a href="/index.html" class="nav-btn home staff-nav-link">
                <span class="label-th">🏠 หน้าแรก</span>
                <span class="label-en">Home</span>
            </a>
            <a href="/api/main/transaction" class="nav-btn transaction staff-nav-link">
                <span class="label-th">👤 ลูกค้าใหม่</span>
                <span class="label-en">New Customer</span>
            </a>
            <a href="/api/main/summary" class="nav-btn summary staff-nav-link">
                <span class="label-th">📊 สรุปรายวัน</span>
                <span class="label-en">Daily Summary</span>
            </a>
            <div class="user-info" id="user-info" style="margin-left: auto; display: flex; align-items: center; gap: 10px;">
                <span id="current-user" style="color: #666; font-size: 14px;"></span>
            </div>
        </div>



        <div class="section today-helper-section">
            <div class="section-header helper-section-header">
                <span class="label-th">รายได้เมื่อวาน น้อยไปมาก</span>
                <button type="button" id="collapse-helper-sections-btn" class="helper-collapse-btn">
                    เสร็จแล้ว ซ่อนตัวช่วย
                </button>
            </div>
            <div class="section-content">
                <div id="today-helper-error" class="staff-empty-state" style="display: none;"></div>
                <div id="today-helper-list" class="today-helper-grid"></div>
            </div>
        </div>

        <div class="section day-off-section" id="day-off-section" style="display: none;">
            <div class="section-header">
                <span class="label-th">หยุดวันนี้</span>
            </div>
            <div class="section-content">
                <div id="day-off-list" class="day-off-grid"></div>
            </div>
        </div>

        <div class="section staff-roster-workflow">
            <div class="section-content">
                <button type="button" id="show-helper-sections-btn" class="helper-restore-btn">
                    แสดงตัวช่วยรายได้เมื่อวาน / หยุดวันนี้
                </button>
                <div class="staff-roster-step">
                    <div class="step-badge">1</div>
                    <div>
                        <h2>เลือกพนักงานที่มาทำงานวันนี้</h2>
                        <p class="helper-text">Select each staff member working today, then add them to the list.</p>
                    </div>
                </div>
                <div class="staff-add-panel">
                    <label class="staff-select-label" for="available-staff">เลือกชื่อพนักงาน</label>
                    <select id="available-staff" class="staff-select-primary">
                        <option value="">แตะเพื่อเลือกพนักงาน...</option>
                    </select>
                    <button id="add-to-roster-btn" class="btn staff-primary-action">
                        เพิ่มเข้ารายชื่อวันนี้
                    </button>
                </div>
                <div class="staff-secondary-actions">
                    <button id="show-add-staff-modal-btn" class="staff-link-action" type="button">
                        + เพิ่มพนักงานใหม่
                    </button>
                    <span class="helper-text">ใช้เฉพาะตอนที่ไม่มีชื่อในรายการ / Only if the name is missing</span>
                    <button id="clear-roster-btn" class="staff-clear-action" type="button">
                        <span class="label-th">ล้างรายชื่อทั้งหมด</span>
                        <span class="label-en">Clear everyone from list</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="section staff-list-section">
            <div class="section-header staff-list-header">
                <span class="label-th">รายชื่อวันนี้</span>
                <span class="helper-text">Drag rows or use arrows to change order.</span>
            </div>
            <div class="section-content">
                <div class="roster-grid roster-grid-header">
                    <div>คิว</div>
                    <div>ชื่อพนักงาน</div>
                    <div>คิวถัดไป</div>
                    <div>นวดแล้ว</div>
                    <div>จัดลำดับ / ลบ</div>
                </div>
                <div id="roster-list">
                    <!-- Today Staff items will be populated by JavaScript -->
                </div>
                <div id="empty-roster" class="staff-empty-state" style="display: none;">
                    ยังไม่มีพนักงานในรายชื่อวันนี้
                    <span class="helper-text">เลือกชื่อด้านบน แล้วกดเพิ่มเข้ารายชื่อวันนี้</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Clear Roster Confirmation Modal -->
    <div id="clear-roster-modal" class="modal">
        <div class="modal-content staff-confirm-modal">
            <div class="modal-header">
                <h2>ล้างรายชื่อทั้งหมด?</h2>
                <span class="close" id="close-clear-roster-modal">&times;</span>
            </div>
            <div class="staff-confirm-body">
                <p class="staff-confirm-primary">ต้องการล้างรายชื่อพนักงานวันนี้ทั้งหมดใช่ไหม?</p>
                <p class="helper-text">This clears only the visible Today Staff list so you can start again. It does not delete All Staff names or accounting history.</p>
            </div>
            <div class="staff-confirm-actions">
                <button type="button" id="cancel-clear-roster-modal" class="btn btn-secondary">ยกเลิก</button>
                <button type="button" id="confirm-clear-roster-btn" class="btn btn-danger">ล้างทั้งหมด</button>
            </div>
        </div>
    </div>

    <!-- Add New Staff Modal -->
    <div id="roster-staff-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>เพิ่มพนักงานใหม่</h2>
                <span class="close" id="close-roster-staff-modal">&times;</span>
            </div>
            <form id="roster-staff-form">
                <div class="form-group">
                    <label for="roster-staff-name">ชื่อพนักงาน</label>
                    <input type="text" id="roster-staff-name" name="name" required maxlength="100" autocomplete="off">
                </div>
                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" id="cancel-roster-staff-modal" class="btn btn-secondary">ยกเลิก</button>
                    <button type="submit" class="btn">บันทึก</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/api.js"></script>
    <script src="/shared.js"></script>
    <script src="/roster-ui.js"></script>
    <script src="/controllers/staff-page-controller.js?v=today-staff-helper" defer></script>
    <script>
      (function boot(){
        function call(){
          try {
            const api = new APIClient('/api');
            window.staffControllerInit?.(api);
          } catch(e) {
            console.error('Staff controller boot failed:', e);
          }
        }
        if (window.staffControllerInit) return call();
        document.addEventListener('DOMContentLoaded', () => {
          const t = setInterval(() => {
            if (window.staffControllerInit) {
              clearInterval(t);
              call();
            }
          }, 20);
          setTimeout(() => clearInterval(t), 3000);
        });
      })();
    </script>
    
    <!-- Logout Button at Bottom -->
    <div style="text-align: center; padding: 20px; margin-top: 20px; border-top: 1px solid #dee2e6;">
        <button onclick="logout()" class="btn" style="background: #ff4444; color: white; padding: 10px 20px;">
            <span class="label-th">👋 ออกจากระบบ</span>
            <span class="label-en">👋 Logout</span>
        </button>
    </div>
</body>
</html>
