        async function handleSubmit(event) {
            event.preventDefault();
            const selectedMasseuse = document.getElementById('masseuse').value;
            const location = document.getElementById('location').value;
            const serviceName = document.getElementById('service').value;
            const duration = document.getElementById('duration').value;

            if (!location || !serviceName || !duration) {
                showToast('กรุณาเลือกสถานที่ บริการ และเวลา', 'error');
                return;
            }

            if (transactionMode === 'booking') {
                const scheduledStart = toBangkokBookingIso(document.getElementById('bookingStart').value);
                if (!scheduledStart) {
                    showToast('กรุณาเลือกเวลาที่จอง', 'error');
                    return;
                }
                try {
                    await api.createBooking({
                        scheduled_start: scheduledStart,
                        service_type: serviceName,
                        location,
                        duration: Number(duration),
                        requested_masseuse_name: selectedMasseuse || null,
                        customer_contact: document.getElementById('customerContact').value
                    });
                    clearForm();
                    await updateUpcomingBookings();
                    showToast(selectedMasseuse ? 'บันทึกการจองพร้อมพนักงานที่ลูกค้าเลือกแล้ว' : 'บันทึกการจองแบบจัดพนักงานตามคิวแล้ว');
                } catch (error) {
                    showToast(error.message, 'error');
                }
                return;
            }

            if (!selectedMasseuse) {
                showToast('กรุณาเลือกพนักงาน', 'error');
                return;
            }

            const payment = document.getElementById('payment').value;
            if (!payment) {
                showToast('กรุณาเลือกวิธีจ่ายเงิน', 'error');
                return;
            }

            const price = parseFloat(document.getElementById('servicePrice').textContent.replace('฿', ''));
            const masseuseFee = currentBaseMasseuseFee;
            if (isNaN(price) || price <= 0) {
                showToast('ราคาไม่ถูกต้อง กรุณาเลือกบริการและเวลาใหม่', 'error');
                return;
            }

            const isUsingNextInLine = selectedMasseuse === autoSelectedMasseuse
                && !(arrivingBooking && arrivingBooking.requested_masseuse_name);
            const formData = {
                masseuse: selectedMasseuse,
                location,
                service: serviceName,
                duration,
                price,
                masseuseFee,
                payment,
                startTime: document.getElementById('startTime').value,
                endTime: document.getElementById('endTime').value,
                customerContact: document.getElementById('customerContact').value,
                original_transaction_id: document.getElementById('original-transaction-id').value || null,
                bookingId: document.getElementById('booking-id').value || null,
                requestedStaffBooking: transactionMode === 'walk-in'
                    && selectedMasseuse !== autoSelectedMasseuse
                    && !arrivingBooking,
                startDateTime: currentStartDateTime,
                endDateTime: currentEndDateTime,
                time_window_promotion_override: timeWindowPromotionOverride
            };

            const success = await submitTransaction(formData);
            if (success) {
                if (isUsingNextInLine) {
                    await advanceQueue(selectedMasseuse);
                }
                await setMasseuseBusy(selectedMasseuse, formData.endTime);
                await loadTodayData();
                await refreshRosterForDropdown();
                clearForm();
                await updateAllDisplays();
                showToast(`รับลูกค้าแล้ว ${selectedMasseuse} ไม่ว่างถึง ${formData.endTime}`);
            }
        }

        async function advanceQueue(currentMasseuse) {
            try {
                // Advance to next person in line
                await api.advanceQueue(currentMasseuse);
                console.log(`🔄 Queue advanced from ${currentMasseuse}`);
            } catch (error) {
                console.error('Error advancing queue:', error);
            }
        }
        
        async function setMasseuseBusy(masseuseName, endTime) {
            try {
                // Set masseuse as busy until end time
                await api.setMasseuseBusy(masseuseName, endTime);
                console.log(`🔒 ${masseuseName} marked as busy until ${endTime}`);
            } catch (error) {
                console.error('Error setting masseuse busy:', error);
            }
        }

        async function refreshRosterForDropdown() {
            try {
                const [roster] = await Promise.all([
                    api.getStaffRoster(),
                    loadCurrentShopStatus()
                ]);
                appData.roster = roster.map(r => ({
                    position: r.position,
                    name: r.masseuse_name || '',
                    status: r.status || null,
                    busy_until: r.busy_until || null,
                    todayCount: r.today_massages || 0
                }));
                renderMasseuseDropdown();
            } catch (error) {
                console.error('Error refreshing Today Staff roster:', error);
            }
        }

        function clearForm() {
            document.getElementById('transaction-form').reset();
            document.getElementById('booking-id').value = '';
            document.getElementById('servicePrice').textContent = '฿0.00';
            document.getElementById('masseuseeFee').textContent = '฿0.00';
            document.getElementById('time-window-promotion-label').hidden = true;
            document.getElementById('time-window-promotion-override').hidden = true;
            timeWindowPromotionOverride = false;
            document.getElementById('location').value = 'In-Shop';
            document.getElementById('masseuse').value = autoSelectedMasseuse;
            arrivingBooking = null;
            setTransactionMode('walk-in');
            updateServiceOptions();
            exitCorrectionMode();
        }

        async function loadCorrection() {
            const transaction = loadTransactionForCorrection();
            if (transaction) {
                document.getElementById('masseuse').value = transaction.masseuse;
                document.getElementById('service').value = transaction.service;
                document.getElementById('payment').value = transaction.paymentMethod;
                document.getElementById('startTime').value = transaction.startTime;
                document.getElementById('endTime').value = transaction.endTime;
                document.getElementById('customerContact').value = transaction.customerContact;
                
                updatePricing();
                enterCorrectionMode();
                await updateAllDisplays();
            }
        }

        function enterCorrectionMode() {
            correctionMode = true;
            document.getElementById('correction-banner').style.display = 'block';
            document.getElementById('transaction-form').classList.add('correction-mode');
            document.getElementById('correction-info').textContent = `กำลังแก้รายการ: ${appData.originalTransactionId}`;
        }

        function exitCorrectionMode() {
            correctionMode = false;
            document.getElementById('correction-banner').style.display = 'none';
            document.getElementById('transaction-form').classList.remove('correction-mode');
            document.getElementById('correction-info').textContent = 'ยังไม่มีรายการที่โหลดมาแก้';
        }

        async function updateAllDisplays() {
            await updateQuickSummary();
            updateRecentTransactions();
            updateExpenseDisplay();
            await updateUpcomingBookings();
        }

        async function updateQuickSummary() {
            const summary = await getTodaySummary();
            
            // Safely handle summary data with defaults
            const todayRevenue = (summary && typeof summary.todayRevenue === 'number') ? summary.todayRevenue : 0;
            const todayCount = (summary && typeof summary.todayCount === 'number') ? summary.todayCount : 0;
            const todayExpenses = (summary && typeof summary.todayExpenses === 'number') ? summary.todayExpenses : 0;
            
            document.getElementById('today-revenue').textContent = `฿${todayRevenue.toFixed(2)}`;
            document.getElementById('today-count').textContent = todayCount;
            document.getElementById('today-expenses').textContent = `฿${todayExpenses.toFixed(2)}`;
            
            // Update payment breakdown
            if (summary) {
                updatePaymentBreakdownMini(summary);
            }
        }

        function updatePaymentBreakdownMini(summary) {
            const container = document.getElementById('payment-breakdown-mini');
            
            if (!summary || !summary.paymentBreakdown || Object.keys(summary.paymentBreakdown).length === 0) {
                container.innerHTML = '<div style="text-align: center; color: #666; font-style: italic;">No payments yet today</div>';
                return;
            }

            let html = '';
            Object.entries(summary.paymentBreakdown)
                .sort(([,a], [,b]) => b.revenue - a.revenue)
                .forEach(([method, data]) => {
                    html += `
                        <div class="summary-grid" style="margin-bottom: 8px;">
                            <div style="font-size: 14px;">${escapeBookingText(method)}:</div>
                            <div style="font-size: 14px; font-weight: bold; color: #34a853;">฿${data.revenue.toFixed(2)} (${data.count})</div>
                        </div>
                    `;
                });
            container.innerHTML = html;
        }

        function updateRecentTransactions() {
            console.log('🔄 STEP 12: updateRecentTransactions() called - starting display update...');
            console.log('🔄 STEP 12: Current appData.transactions:', window.appData?.transactions);
            console.log('🔄 STEP 12: Current appData.transactions length:', window.appData?.transactions?.length);
            
            const container = document.getElementById('recent-transactions');
            if (!container) {
                console.log('❌ STEP 12: ERROR - recent-transactions container not found');
                return;
            }
            console.log('🔄 STEP 12: Found recent-transactions container');
            
            console.log('🔄 STEP 12: Calling getRecentTransactions(5) with date filter...');
            const today = new Date().toISOString().split('T')[0];
            const recentTransactions = getRecentTransactions(5, today);
            console.log('🔄 STEP 12: getRecentTransactions(5) returned:', recentTransactions);
            console.log('🔄 STEP 12: getRecentTransactions(5) length:', recentTransactions?.length);

            // Preserve the header before clearing
            const headerHTML = `
                <div class="transaction-item">
                    <div>จ่าย</div>
                    <div>พนักงาน</div>
                    <div>บริการ</div>
                    <div>ยอด</div>
                </div>
            `;
            
            console.log('🔄 STEP 12: Setting container HTML to header...');
            container.innerHTML = headerHTML;
            console.log('🔄 STEP 12: Container HTML after header:', container.innerHTML.substring(0, 200));

            if (recentTransactions.length === 0) {
                console.log('🔄 STEP 12: No recent transactions, showing empty state...');
                const div = document.createElement('div');
                div.className = 'empty-state';
                div.innerHTML = '<div>ยังไม่มีรายการวันนี้</div>';
                container.appendChild(div);
                console.log('🔄 STEP 12: Empty state added to container');
                return;
            }

            console.log('🔄 STEP 12: Adding transaction items to container...');
            recentTransactions.forEach((transaction, index) => {
                console.log(`🔄 STEP 12: Processing transaction ${index + 1}:`, transaction);
                
                const div = document.createElement('div');
                div.className = 'transaction-item';
                
                const bookingCreditBadge = Number(transaction.bookingCredit || 0) > 0
                    ? '<span class="transaction-booking-credit-badge">จองพนักงาน +฿50</span>'
                    : '';
                div.innerHTML = `
                    <div>${escapeBookingText(transaction.paymentMethod || '')}</div>
                    <div>${escapeBookingText(transaction.masseuse || '')}</div>
                    <div>${escapeBookingText(transaction.service || '')} ${bookingCreditBadge}</div>
                    <div>฿${Number(transaction.paymentAmount || 0).toFixed(2)}</div>
                    ${transaction.status && transaction.status.includes('EDITED') ? '<div class="edited-status-badge">(EDITED)</div>' : ''}
                `;
                
                // Add EDITED styling logic AFTER setting innerHTML (FIXED)
                if (transaction.status && transaction.status.includes('EDITED')) {
                    div.classList.add('edited-transaction');
                    console.log(`🔄 STEP 12: Applied edited-transaction class to transaction ${index + 1}`);
                }
                container.appendChild(div);
                console.log(`🔄 STEP 12: Transaction item ${index + 1} added to container`);
            });
            
            console.log('🔄 STEP 12: Final container HTML:', container.innerHTML.substring(0, 500));
            console.log('✅ STEP 12: updateRecentTransactions() completed successfully');
        }

        function updateExpenseDisplay() {
            const expenseList = document.getElementById('expense-list');
            
            if (appData.expenses.length === 0) {
                expenseList.innerHTML = '<div style="text-align: center; color: #666; padding: 20px;">ยังไม่มีค่าใช้จ่ายวันนี้</div>';
                return;
            }

            expenseList.innerHTML = appData.expenses.map((expense, index) => `
                <div class="expense-grid">
                    <div>${escapeBookingText(expense.description || '')}</div>
                    <div>฿${Number(expense.amount || 0).toFixed(2)}</div>
                    <div><button class="btn btn-danger" style="padding: 5px 10px; font-size: 12px;" onclick="handleRemoveExpense(${index})">ลบ</button></div>
                    <div class="expense-time">${formatTime(expense.timestamp)}</div>
                </div>
            `).join('');
        }

        async function handleAddExpense() {
            const description = document.getElementById('newExpenseDesc').value.trim();
            const amount = parseFloat(document.getElementById('newExpenseAmount').value);

            if (addExpense(description, amount)) {
                document.getElementById('newExpenseDesc').value = '';
                document.getElementById('newExpenseAmount').value = '';
                await updateAllDisplays();
            }
        }

        async function handleRemoveExpense(index) {
            if (await removeExpense(index)) {
                await updateAllDisplays();
            }
        }

        function renderMasseuseDropdown() {
            const masseuseSelect = document.getElementById('masseuse');
            if (!masseuseSelect) return;

            console.log('🔍 STEP 2: Setting masseuse innerHTML...');
            masseuseSelect.innerHTML = '<option value="">เลือกพนักงาน...</option>';
            console.log('🔍 STEP 2a: Masseuse innerHTML set successfully');

            console.log('🔍 STEP 3: Finding next in line masseuse...');
            const nextInLineName = getNextInLineFromStaff();
            autoSelectedMasseuse = nextInLineName || '';
            const availabilityMessage = document.getElementById('masseuse-availability-message');
            if (availabilityMessage) {
                availabilityMessage.textContent = noAvailableStaffMessage;
                availabilityMessage.hidden = transactionMode === 'booking' || !noAvailableStaffMessage;
            }
            console.log('🔍 STEP 3a: Next in line found:', nextInLineName);

            console.log('🔍 STEP 4: Adding masseuse options...');
            const orderedMasseuses = appData.roster
                .filter(r => r.name)
                .sort((a, b) => (a.position || 999) - (b.position || 999))
                .map(r => r.name);
            const masseuseNames = orderedMasseuses.length ? orderedMasseuses : CONFIG.settings.masseuses;
            masseuseNames.forEach(name => {
                const option = document.createElement('option');
                option.value = name;
                option.textContent = `${name}${name === nextInLineName ? ' (คิวถัดไป)' : ''}`;
                option.selected = name === nextInLineName;
                option.disabled = transactionMode !== 'booking' && isMasseuseUnavailableForWalkIn(name);
                masseuseSelect.appendChild(option);
            });
            console.log('🔍 STEP 4a: Masseuse options added successfully');
        }

        function populateDropdowns() {
            try {
                console.log('🔍 POPULATE DROPDOWNS - CONFIG.settings:', CONFIG.settings);
                console.log('🔍 Masseuses:', CONFIG.settings.masseuses);
                console.log('🔍 Services:', CONFIG.settings.services);
                console.log('🔍 Payment Methods:', CONFIG.settings.paymentMethods);
                
                // Wait for all required DOM elements to be ready
                console.log('🔍 WAITING FOR DOM ELEMENTS TO BE READY...');
                const requiredElements = ['masseuse', 'service', 'duration', 'payment', 'location'];
                const missingElements = [];
                
                requiredElements.forEach(id => {
                    const element = document.getElementById(id);
                    if (!element) {
                        missingElements.push(id);
                        console.log(`❌ Missing element: ${id}`);
                    } else {
                        console.log(`✅ Element found: ${id}`);
                    }
                });
                
                if (missingElements.length > 0) {
                    console.log(`❌ Cannot proceed - missing elements: ${missingElements.join(', ')}`);
                    return;
                }
                
                console.log('✅ All required DOM elements are ready, proceeding...');
            
                console.log('🔍 STEP 1: Getting masseuse select element...');
                const masseuseSelect = document.getElementById('masseuse');
                console.log('🔍 STEP 1a: Masseuse select element found:', !!masseuseSelect);
                
                renderMasseuseDropdown();

                console.log('🔍 STEP 5: Initializing service and duration dropdowns...');
                // Initialize service and duration dropdowns with default state
                let serviceSelect = document.getElementById('service');
                let durationSelect = document.getElementById('duration');
                
                console.log('🔍 STEP 5a: Service select element found:', !!serviceSelect);
                if (serviceSelect) {
                    serviceSelect.innerHTML = '<option value="">เลือกบริการ...</option>';
                    console.log('✅ Service dropdown initialized');
                } else {
                    console.log('❌ Service dropdown element not found');
                }
                
                console.log('🔍 STEP 5b: Duration select element found:', !!durationSelect);
                if (durationSelect) {
                    durationSelect.innerHTML = '<option value="">เลือกระยะเวลา...</option>';
                    console.log('✅ Duration dropdown initialized');
                } else {
                    console.log('❌ Duration dropdown element not found');
                }

                console.log('🔍 STEP 6: Setting up payment methods...');
                let paymentSelect = document.getElementById('payment');
                console.log('🔍 STEP 6a: Payment select element found:', !!paymentSelect);
                
                if (paymentSelect) {
                    paymentSelect.innerHTML = '<option value="">เลือกวิธีจ่ายเงิน...</option>';
                    console.log('🔍 STEP 6b: Payment options cleared, adding methods...');
                    CONFIG.settings.paymentMethods.forEach(method => {
                        const option = document.createElement('option');
                        option.value = method;
                        option.textContent = method;
                        paymentSelect.appendChild(option);
                    });
                    console.log('🔍 STEP 6c: Payment methods added successfully');
                } else {
                    console.log('❌ Payment select element not found');
                }
                
                console.log('🔍 STEP 7: DROPDOWNS POPULATED - Next in line:', autoSelectedMasseuse);
                
                // Add event listeners for dropdown changes after elements are populated
                console.log('🔍 ADDING EVENT LISTENERS...');
                
                console.log('🔍 CHECKING IF LOCATION ELEMENT EXISTS...');
                const locationSelect = document.getElementById('location');
                console.log('🔍 Location element found:', !!locationSelect);
                if (locationSelect) {
                    console.log('🔍 Location element properties:', {
                        tagName: locationSelect.tagName,
                        id: locationSelect.id,
                        innerHTML: locationSelect.innerHTML.substring(0, 100) + '...'
                    });
                }
                
                console.log('🔍 CHECKING IF SERVICE ELEMENT EXISTS...');
                // Reassign existing variables (don't redeclare)
                serviceSelect = document.getElementById('service');
                console.log('🔍 Service element found:', !!serviceSelect);
                
                console.log('🔍 CHECKING IF DURATION ELEMENT EXISTS...');
                durationSelect = document.getElementById('duration');
                console.log('🔍 Duration element found:', !!durationSelect);
                
                console.log('🔍 CHECKING IF PAYMENT ELEMENT EXISTS...');
                paymentSelect = document.getElementById('payment');
                console.log('🔍 Payment element found:', !!paymentSelect);
                
                // Ensure all variables are properly assigned before logging
                console.log('🔍 Elements found:', {
                    location: !!locationSelect,
                    service: !!serviceSelect,
                    duration: !!durationSelect,
                    payment: !!paymentSelect
                });
                
                console.log('🔍 ABOUT TO ADD LOCATION EVENT LISTENER...');
                if (locationSelect) {
                    console.log('🔍 LOCATION ELEMENT FOUND, ADDING EVENT LISTENER...');
                    try {
                        console.log('🔍 Creating location event listener function...');
                        const locationChangeHandler = function() {
                            console.log('🔍 LOCATION CHANGED TO:', this.value);
                            updateServiceOptions();
                            updatePricing();
                            updateTimeDropdowns();
                        };
                        console.log('🔍 Location event listener function created successfully');
                        
                        console.log('🔍 Adding location event listener to DOM...');
                        locationSelect.addEventListener('change', locationChangeHandler);
                        console.log('✅ Location event listener added');
                    } catch (e) {
                        console.error('❌ ERROR adding location event listener:', e.message);
                        console.error('❌ ERROR stack:', e.stack);
                    }
                } else {
                    console.log('❌ Location element not found');
                }
                
                console.log('🔍 ABOUT TO ADD SERVICE EVENT LISTENER...');
                if (serviceSelect) {
                    console.log('🔍 SERVICE ELEMENT FOUND, ADDING EVENT LISTENER...');
                    try {
                        console.log('🔍 Creating service event listener function...');
                        const serviceChangeHandler = function() {
                            console.log('🔍 SERVICE CHANGED TO:', this.value);
                            updateDurationOptions();
                            updatePricing();
                            updateTimeDropdowns();
                        };
                        console.log('🔍 Service event listener function created successfully');
                        
                        console.log('🔍 Adding service event listener to DOM...');
                        serviceSelect.addEventListener('change', serviceChangeHandler);
                        console.log('✅ Service event listener added');
                    } catch (e) {
                        console.error('❌ ERROR adding service event listener:', e.message);
                        console.error('❌ ERROR stack:', e.stack);
                    }
                } else {
                    console.log('❌ Service element not found');
                }
                
                console.log('🔍 ABOUT TO ADD DURATION EVENT LISTENER...');
                if (durationSelect) {
                    console.log('🔍 DURATION ELEMENT FOUND, ADDING EVENT LISTENER...');
                    try {
                        console.log('🔍 Creating duration event listener function...');
                        const durationChangeHandler = function() {
                            console.log('🔍 DURATION CHANGED TO:', this.value);
                            updatePricing();
                            updateTimeDropdowns();
                        };
                        console.log('🔍 Duration event listener function created successfully');
                        
                        console.log('🔍 Adding duration event listener to DOM...');
                        durationSelect.addEventListener('change', durationChangeHandler);
                        console.log('✅ Duration event listener added');
                    } catch (e) {
                        console.error('❌ ERROR adding duration event listener:', e.message);
                        console.error('❌ ERROR stack:', e.stack);
                    }
                } else {
                    console.log('❌ Duration element not found');
                }
                
                console.log('🔍 ABOUT TO ADD PAYMENT EVENT LISTENER...');
                if (paymentSelect) {
                    console.log('🔍 PAYMENT ELEMENT FOUND, ADDING EVENT LISTENER...');
                    try {
                        console.log('🔍 Creating payment event listener function...');
                        const paymentChangeHandler = function() {
                            console.log('🔍 PAYMENT CHANGED TO:', this.value);
                            updateTimeDropdowns();
                        };
                        console.log('🔍 Payment event listener function created successfully');
                        
                        console.log('🔍 Adding payment event listener to DOM...');
                        paymentSelect.addEventListener('change', paymentChangeHandler);
                        console.log('✅ Payment event listener added');
                    } catch (e) {
                        console.error('❌ ERROR adding payment event listener:', e.message);
                        console.error('❌ ERROR stack:', e.stack);
                    }
                } else {
                    console.log('❌ Payment element not found');
                }

                document.getElementById('bookingStart').addEventListener('change', updateBookingEndPreview);
                
                console.log('🔍 ALL EVENT LISTENERS PROCESSED - FUNCTION COMPLETING...');
                if (locationSelect && !locationSelect.value) {
                    locationSelect.value = 'In-Shop';
                }
                if (locationSelect && locationSelect.value) {
                    updateServiceOptions();
                    updatePricing();
                    updateTimeDropdowns();
                }
            } catch (error) {
                console.error('❌ ERROR in populateDropdowns:', error);
            }
        }
    </script>
    
    <!-- Logout Button at Bottom -->
    <div style="text-align: center; padding: 20px; margin-top: 20px; border-top: 1px solid #dee2e6;">
                    <button onclick="logout()" class="btn" style="background: #ff4444; color: white; padding: 10px 20px;">
                <span class="label-th">👋 ออกจากระบบ</span>
                <span class="label-en">👋 Logout</span>
            </button>
    </div>
</body>
</html>
