            console.log('🔍 STEP 8d: Selected duration type:', typeof selectedDuration);
            
            if (selectedDuration) {
                console.log('🔍 STEP 9: Duration selected, calculating end time');
                // Convert duration string to minutes (e.g., "60" -> 60)
