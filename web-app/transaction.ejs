<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script
      src="https://js-de.sentry-cdn.com/6604be417c099671b7ee6e98970c90d6.min.js"
      crossorigin="anonymous"
    ></script>
    <title>Massage Shop POS - New Customer</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <div class="nav-header transaction-page-title">
            <span class="label-th">รับลูกค้าใหม่</span>
            <span class="label-en helper-text">New Customer</span>
        </div>

        <div class="nav-buttons staff-page-nav transaction-page-nav">
            <a href="/index.html" class="nav-btn home staff-nav-link">
                <span class="label-th">🏠 หน้าแรก</span>
                <span class="label-en">Home</span>
            </a>
            <a href="/api/main/staff-roster" class="nav-btn staff staff-nav-link">
                <span class="label-th">👥 พนักงานวันนี้</span>
                <span class="label-en">Daily Staff</span>
            </a>
            <a href="/api/main/summary" class="nav-btn summary staff-nav-link">
                <span class="label-th">📊 สรุปรายวัน</span>
                <span class="label-en">Daily Summary</span>
            </a>
                            <div class="user-info" id="user-info" style="margin-left: auto; display: flex; align-items: center; gap: 10px;">
                    <span id="current-user" style="color: #666; font-size: 14px;"></span>
                </div>
        </div>

        <!-- Correction Mode Banner -->
        <div id="correction-banner" class="correction-banner" style="display: none;">
            🔄 CORRECTION MODE: Editing previous transaction
        </div>

        <div class="main-grid transaction-layout">
            <!-- Left Column: Transaction Form -->
            <div>
                <div class="section transaction-intake-workflow">
                    <div class="section-content">
                        <form id="transaction-form" method="POST" action="javascript:void(0)" onsubmit="return false;">
                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                            <input type="hidden" id="original-transaction-id" name="original_transaction_id">
                            <input type="hidden" id="booking-id" name="booking_id">
                            <div class="transaction-roster-step">
                                <div class="step-badge">1</div>
                                <div>
                                    <h2>เลือกพนักงานและบริการ</h2>
                                    <p class="helper-text">Start with the staff member, then choose the service details for this customer.</p>
                                </div>
                            </div>
                            <div class="transaction-mode-switch" role="group" aria-label="เลือกประเภทลูกค้า">
                                <button type="button" id="walk-in-mode-button" class="transaction-mode-button is-active" onclick="setTransactionMode('walk-in')">
                                    ลูกค้ามาแล้ว
                                    <small>Walk-in</small>
                                </button>
                                <button type="button" id="booking-mode-button" class="transaction-mode-button" onclick="setTransactionMode('booking')">
                                    จองเวลา
                                    <small>Booking</small>
                                </button>
                            </div>
                            <div id="booking-mode-note" class="transaction-booking-note" hidden>
                                เลือกพนักงานเมื่อลูกค้าระบุชื่อ หรือปล่อยว่างเพื่อจัดตามคิวตอนลูกค้ามาถึง
                            </div>
                            <div class="transaction-field-grid">
                                <div class="form-group transaction-field transaction-field-large">
                                    <label for="masseuse">พนักงาน</label>
                                    <select id="masseuse" name="masseuse" required>
                                        <option value="">เลือกพนักงาน...</option>
                                    </select>
                                    <div id="masseuse-availability-message" class="transaction-availability-message" hidden></div>
                                </div>

                                <div class="form-group transaction-field" id="payment-field">
                                    <label for="location">สถานที่</label>
                                    <select id="location" name="location" required>
                                        <option value="">เลือกสถานที่...</option>
                                        <option value="In-Shop" selected>ที่ร้าน</option>
                                        <option value="Home Service">นอกสถานที่</option>
                                    </select>
                                </div>

                                <div class="form-group transaction-field transaction-field-large">
                                    <label for="service">บริการ</label>
                                    <div id="service-category-buttons" class="transaction-choice-grid transaction-category-grid" aria-label="เลือกประเภทบริการ"></div>
                                    <div id="combo-service-panel" class="transaction-subchoice-panel" hidden>
                                        <div class="transaction-subchoice-title">เลือกคอมโบ</div>
                                        <div id="combo-service-buttons" class="transaction-choice-grid transaction-combo-grid"></div>
                                    </div>
                                    <select id="service" name="service" class="transaction-native-select-hidden" aria-hidden="true" tabindex="-1">
                                        <option value="">เลือกบริการ...</option>
                                    </select>
                                </div>

                                <div class="form-group transaction-field">
                                    <label for="duration">เวลา</label>
                                    <div id="duration-button-panel" class="transaction-choice-grid transaction-duration-grid" aria-label="เลือกระยะเวลา"></div>
                                    <select id="duration" name="duration" class="transaction-native-select-hidden" aria-hidden="true" tabindex="-1">
                                        <option value="">เลือกระยะเวลา...</option>
                                    </select>
                                </div>

                                <div class="form-group transaction-field">
                                    <label for="payment">จ่ายเงิน</label>
                                    <select id="payment" name="payment" required>
                                        <option value="">เลือกวิธีจ่ายเงิน...</option>
                                    </select>
                                </div>

                                <div class="form-group transaction-field">
                                    <label for="customerContact">ชื่อลูกค้า / เบอร์โทร</label>
                                    <input type="text" id="customerContact" maxlength="100" placeholder="ไม่บังคับ">
                                </div>
                            </div>

                            <div class="transaction-time-price-panel">
                                <div class="form-group transaction-time-field" id="walk-in-start-field">
                                    <label for="startTime">เริ่ม</label>
                                    <input type="text" id="startTime" name="startTime" required readonly class="readonly">
                                </div>

                                <div class="form-group transaction-time-field" id="booking-start-field" hidden>
                                    <label for="bookingStart">เวลาที่จอง</label>
                                    <input type="datetime-local" id="bookingStart" name="bookingStart" step="60">
                                </div>

                                <div class="form-group transaction-time-field">
                                    <label for="endTime">เสร็จ</label>
                                    <select id="endTime" name="endTime" required>
                                        <option value="">เลือกเวลาเสร็จ...</option>
                                    </select>
                                </div>

                                <div class="transaction-total-card">
                                    <span>ราคา</span>
                                    <strong id="servicePrice" class="summary-value">฿0.00</strong>
                                    <small id="time-window-promotion-label" hidden></small>
                                    <button id="time-window-promotion-override" class="transaction-link-action" type="button" hidden onclick="applyTimeWindowPromotionOverride()">ใช้ราคาโปร 10:00-18:00</button>
                                </div>

                                <div class="transaction-fee-card">
                                    <span>ค่าพนักงาน</span>
                                    <strong id="masseuseeFee" class="summary-value">฿0.00</strong>
                                </div>

                            </div>

                            <button type="submit" id="transaction-submit-button" class="btn transaction-primary-action">
                                บันทึกลูกค้าใหม่
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Correction Section -->
                <div class="section transaction-correction-section">
                    <div class="section-header transaction-secondary-header">แก้รายการผิด</div>
                    <div class="section-content">
                        <div id="correction-info" class="helper-text">
                            ยังไม่มีรายการที่โหลดมาแก้
                        </div>
                        <button class="transaction-link-action" onclick="loadCorrection()" type="button">
                            โหลดรายการล่าสุดมาแก้
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column: Mini Summary and Recent Transactions -->
            <div>
                <div class="section transaction-side-section transaction-bookings-section">
                    <div class="section-header transaction-side-header">รายการจองถัดไป</div>
                    <div class="section-content">
                        <div id="upcoming-bookings" class="transaction-booking-list">
                            <div class="helper-text">ยังไม่มีรายการจอง</div>
                        </div>
                    </div>
                </div>
                <!-- Quick Daily Summary -->
                <div class="section transaction-side-section">
                    <div class="section-header transaction-side-header">สรุปวันนี้</div>
                    <div class="section-content">
                        <div class="summary-grid">
                            <div class="summary-label">ยอดขายวันนี้</div>
                            <div class="summary-value" id="today-revenue">฿0.00</div>
                        </div>
                        <div class="summary-grid">
                            <div class="summary-label">จำนวนลูกค้า</div>
                            <div class="summary-value" id="today-count">0</div>
                        </div>
                        <div class="summary-grid">
                            <div class="summary-label">ค่าใช้จ่าย</div>
                            <div class="summary-value" id="today-expenses">฿0.00</div>
                        </div>
                        
                        <!-- Payment Breakdown -->
                        <h4 class="transaction-mini-heading">แยกตามวิธีจ่ายเงิน</h4>
                        <div id="payment-breakdown-mini"></div>
                    </div>
                </div>

                <!-- Recent Transactions -->
                <div class="section transaction-side-section">
                    <div class="section-header transaction-side-header">รายการล่าสุด</div>
                    <div class="section-content">
                        <div class="transaction-log" id="recent-transactions">
                            <div class="transaction-item">
                                <div>จ่าย</div>
                                <div>พนักงาน</div>
                                <div>บริการ</div>
                                <div>ยอด</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Daily Expenses -->
                <div class="section transaction-side-section">
                    <div class="section-header transaction-side-header">ค่าใช้จ่ายวันนี้</div>
                    <div class="section-content">
                        <div id="expense-list"></div>
                        <div style="margin-top: 15px;">
                            <div class="expense-grid transaction-expense-grid">
                                <input type="text" id="newExpenseDesc" placeholder="รายการค่าใช้จ่าย">
                                <input type="number" id="newExpenseAmount" placeholder="จำนวนเงิน" step="0.01" min="0">
                                <button class="btn transaction-expense-action" onclick="handleAddExpense()">เพิ่ม</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/api.js"></script>
    <script src="/shared.js"></script>
    <script>
        console.log('🚀 TRANSACTION.HTML SCRIPT LOADING...');
        
        let correctionMode = false;
        let transactionMode = 'walk-in';
        let currentBaseMasseuseFee = 0;
        let timeWindowPromotionOverride = false;
        let autoSelectedMasseuse = '';
        let noAvailableStaffMessage = '';
        let arrivingBooking = null;
        let upcomingBookings = [];
        let currentStartDateTime = null;
        let currentEndDateTime = null;

        // =========================================================================
        // INITIALIZATION LOGIC
        // =========================================================================
        console.log('🚀 ADDING DOM CONTENT LOADED LISTENER...');
        document.addEventListener('DOMContentLoaded', async function() {
            try {
                console.log('🚀 DOM LOADED - Starting initialization');
                
                // Check authentication first
                if (!requireAuth()) {
                    return;
                }
                
                // Display current user
                const user = getCurrentUser();
                if (user) {
                    renderCurrentUser();
                }
                
                await loadData(); // Load data from API first
                console.log('🚀 DATA LOADED - CONFIG:', CONFIG);
                populateDropdowns(); // Then populate dropdowns with loaded data
                await updateAllDisplays();
                handleURLParams();
                checkForEdit(); // Check for a transaction to edit
            } catch (error) {
                console.error('🚨 CRITICAL ERROR in DOMContentLoaded:', error);
            }
            
            console.log('🔍 ATTACHING SUBMIT EVENT LISTENER...');
            const form = document.getElementById('transaction-form');
            console.log('🔍 Form element found:', !!form);
            if (form) {
                form.addEventListener('submit', handleSubmit);
                console.log('✅ Submit event listener attached successfully');
            } else {
                console.error('❌ Form element not found for event listener');
            }
            
            // Event listeners will be added in populateDropdowns function after elements are populated
            
            // Auto-refresh displays and roster every 30 seconds to clear expired busy statuses
            setInterval(async () => {
                await updateAllDisplays();
                // Refresh the roster and live availability snapshot together.
                await refreshRosterForDropdown();
            }, 30000);
        });

        function checkForEdit() {
            const transactionJSON = sessionStorage.getItem('transactionToEdit');
            if (transactionJSON) {
                try {
                    const transaction = JSON.parse(transactionJSON);
                    
                    // Put form into Edit Mode
                    document.getElementById('correction-banner').textContent = `✏️ EDIT MODE: Modifying Transaction #${transaction.id}`;
                    document.getElementById('correction-banner').style.display = 'block';
                    document.querySelector('.nav-header').innerHTML = '<span class="label-th">แก้รายการลูกค้า</span><span class="label-en helper-text">Edit Customer Transaction</span>';
                    document.getElementById('original-transaction-id').value = transaction.id;
                    document.getElementById('booking-id').value = transaction.bookingId || '';

                    // Populate form fields
                    document.getElementById('masseuse').value = transaction.masseuse;
                    document.getElementById('location').value = transaction.location;
                    
                    // We need to trigger the 'change' event to load the correct service options
                    document.getElementById('location').dispatchEvent(new Event('change'));

                    // Use a short delay to allow service/duration dropdowns to populate
                    setTimeout(() => {
                        document.getElementById('service').value = transaction.service;
                        document.getElementById('service').dispatchEvent(new Event('change'));

                        setTimeout(() => {
                            document.getElementById('duration').value = transaction.duration;
                            document.getElementById('duration').dispatchEvent(new Event('change'));
                        
                            document.getElementById('payment').value = transaction.paymentMethod;
                            document.getElementById('customerContact').value = transaction.customerContact;
                        }, 100); 
                    }, 100);

                    // Set global state for correction mode
                    appData.correctionMode = true;
                    appData.originalTransactionId = transaction.id;

                    // Clean up sessionStorage
                    sessionStorage.removeItem('transactionToEdit');

                } catch (error) {
                    console.error('Error parsing transaction data for editing:', error);
                    sessionStorage.removeItem('transactionToEdit');
                }
            }
        }

        function handleURLParams() {
            const params = new URLSearchParams(window.location.search);
            const masseuse = params.get('masseuse');
            if (masseuse) {
                document.getElementById('masseuse').value = masseuse;
            }
        }

        function getNextInLineFromStaff() {
            const liveStaff = appData.currentShopStatus && Array.isArray(appData.currentShopStatus.staff)
                ? appData.currentShopStatus.staff
                : [];
            const availableLiveStaff = liveStaff
                .filter(staff => staff.masseuse_name && staff.current_state === 'available')
                .sort((a, b) => (a.position || 999) - (b.position || 999));
            const liveNext = availableLiveStaff.find(staff => staff.walk_in_priority) || availableLiveStaff[0];
            if (liveNext) {
                noAvailableStaffMessage = '';
                return liveNext.masseuse_name;
            }
            const nextFreeAt = liveStaff
                .map(staff => staff.free_at_iso || (staff.next_booking?.scheduled_end
                    ? new Date(Date.parse(staff.next_booking.scheduled_end) + 15 * 60000).toISOString()
                    : null))
                .filter(Boolean)
                .sort()[0];
            noAvailableStaffMessage = nextFreeAt
                ? `ตอนนี้พนักงานทุกคนไม่ว่าง · คนถัดไปจะว่างรับลูกค้าได้เวลา ${formatBookingTime(nextFreeAt)}`
                : 'ตอนนี้พนักงานทุกคนไม่ว่าง · กรุณารอหรือเลือกเวลานัดหมาย';
            const rosterNames = appData.roster
                .filter(r => r.name)
                .filter(r => !liveStaff.some(staff => staff.masseuse_name === r.name && staff.current_state !== 'available'))
                .sort((a, b) => (a.position || 999) - (b.position || 999));
            const nextStaff = rosterNames.find(r => r.status === 'Next') || rosterNames[0];
            return nextStaff ? nextStaff.name : null;
        }

        function toBangkokBookingIso(localValue) {
            return localValue ? `${localValue}:00+07:00` : '';
        }

        function formatBookingTime(isoValue) {
            if (!isoValue) return '';
            return new Date(isoValue).toLocaleTimeString('en-US', {
                hour: 'numeric',
                minute: '2-digit',
                hour12: true,
                timeZone: 'Asia/Bangkok'
            });
        }

        function escapeBookingText(value) {
            return String(value || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function setDefaultBookingStart() {
            const input = document.getElementById('bookingStart');
            if (!input || input.value) return;
            const now = new Date();
            const bangkokNow = new Date(now.getTime() + ((7 * 60 + now.getTimezoneOffset()) * 60000));
            bangkokNow.setSeconds(0, 0);
            input.value = `${bangkokNow.getFullYear()}-${String(bangkokNow.getMonth() + 1).padStart(2, '0')}-${String(bangkokNow.getDate()).padStart(2, '0')}T${String(bangkokNow.getHours()).padStart(2, '0')}:${String(bangkokNow.getMinutes()).padStart(2, '0')}`;
        }

        function updateBookingEndPreview() {
            const startValue = document.getElementById('bookingStart').value;
            const duration = Number(document.getElementById('duration').value);
            const endTimeSelect = document.getElementById('endTime');
            endTimeSelect.innerHTML = '<option value="">เลือกเวลาเสร็จ...</option>';
            if (!startValue || !duration) return;
            const end = new Date(`${toBangkokBookingIso(startValue)}`);
            end.setMinutes(end.getMinutes() + duration);
            const displayEnd = formatBookingTime(end.toISOString());
            endTimeSelect.innerHTML += `<option value="${displayEnd}" selected>${displayEnd}</option>`;
        }

        function setTransactionMode(mode, options = {}) {
            transactionMode = mode;
            arrivingBooking = mode === 'arrival' ? arrivingBooking : null;
            const isBooking = mode === 'booking';
            const isArrival = mode === 'arrival';
            const payment = document.getElementById('payment');
            const masseuse = document.getElementById('masseuse');

            document.getElementById('walk-in-mode-button').classList.toggle('is-active', !isBooking);
            document.getElementById('booking-mode-button').classList.toggle('is-active', isBooking);
            document.getElementById('booking-mode-note').hidden = !isBooking;
            document.getElementById('booking-start-field').hidden = !isBooking;
            document.getElementById('walk-in-start-field').hidden = isBooking;
            document.getElementById('payment-field').hidden = isBooking;
            payment.required = !isBooking;
            masseuse.required = !isBooking;

            if (isBooking) {
                if (!options.preserveMasseuse) masseuse.value = '';
                setDefaultBookingStart();
                updateBookingEndPreview();
                document.getElementById('transaction-submit-button').textContent = 'บันทึกการจอง';
            } else {
                if (!isArrival && !masseuse.value) masseuse.value = autoSelectedMasseuse;
                document.getElementById('transaction-submit-button').textContent = isArrival
                    ? 'ยืนยันการจ่ายเงินและรับลูกค้า'
                    : 'บันทึกลูกค้าใหม่';
                updateTimeDropdowns();
            }
            refreshMasseuseAvailabilityOptions();
        }

        function isMasseuseUnavailableForWalkIn(name) {
            const staff = appData.currentShopStatus?.staff?.find(row => row.masseuse_name === name);
            return Boolean(staff && staff.current_state !== 'available');
        }

        function refreshMasseuseAvailabilityOptions() {
            document.querySelectorAll('#masseuse option[value]').forEach(option => {
                option.disabled = transactionMode !== 'booking' && isMasseuseUnavailableForWalkIn(option.value);
            });
            const select = document.getElementById('masseuse');
            if (transactionMode !== 'booking' && select?.selectedOptions[0]?.disabled) {
                select.value = autoSelectedMasseuse || '';
            }
        }

        async function updateUpcomingBookings() {
            const container = document.getElementById('upcoming-bookings');
            try {
                upcomingBookings = await api.getUpcomingBookings();
                if (!upcomingBookings.length) {
                    container.innerHTML = '<div class="helper-text">ยังไม่มีรายการจอง</div>';
                    return;
                }
                container.innerHTML = upcomingBookings.map(booking => `
                    <div class="transaction-booking-row">
                        <div>
                            <strong>${formatBookingTime(booking.scheduled_start)}</strong>
                            <span><b>ลูกค้า:</b> ${escapeBookingText(booking.customer_contact || 'ไม่ระบุชื่อ')}</span>
                            <span><b>บริการ:</b> ${escapeBookingText(booking.service_type)} · ${Number(booking.duration)} นาที</span>
                            <span><b>พนักงาน:</b> ${escapeBookingText(booking.requested_masseuse_name || 'จัดตามคิวเมื่อลูกค้ามาถึง')}</span>
                        </div>
                        <div class="transaction-booking-actions">
                            <button type="button" onclick="loadBookingForArrival('${booking.booking_id}')">ลูกค้ามาถึง</button>
                            <button type="button" class="transaction-booking-no-show" onclick="markBookingNoShow('${booking.booking_id}')">ไม่มา (No-show)</button>
                        </div>
                    </div>
                `).join('');
            } catch (error) {
                container.innerHTML = '<div class="helper-text transaction-booking-error">โหลดรายการจองไม่ได้</div>';
            }
        }

        async function markBookingNoShow(bookingId) {
            if (!window.confirm('ยืนยันว่าลูกค้าไม่มา และปิดรายการจองนี้ใช่ไหม?')) return;
            try {
                await api.updateBookingStatus(bookingId, 'NO_SHOW');
                await updateUpcomingBookings();
                await refreshRosterForDropdown();
                showToast('ปิดรายการจองเป็นไม่มาแล้ว');
            } catch (error) {
                showToast(error.message || 'ปิดรายการจองไม่ได้', 'error');
            }
        }

        function loadBookingForArrival(bookingId) {
            const booking = upcomingBookings.find(item => item.booking_id === bookingId);
            if (!booking) return;
            arrivingBooking = booking;
            document.getElementById('booking-id').value = booking.booking_id;
            document.getElementById('location').value = booking.location;
            document.getElementById('location').dispatchEvent(new Event('change'));
            document.getElementById('customerContact').value = booking.customer_contact || '';
            document.getElementById('masseuse').value = booking.requested_masseuse_name || autoSelectedMasseuse;
            setTransactionMode('arrival');

            setTimeout(() => {
                document.getElementById('service').value = booking.service_type;
                document.getElementById('service').dispatchEvent(new Event('change'));
                setTimeout(() => {
                    document.getElementById('duration').value = String(booking.duration);
                    document.getElementById('duration').dispatchEvent(new Event('change'));
                    document.getElementById('startTime').value = formatBookingTime(booking.scheduled_start);
                    const endTime = formatBookingTime(booking.scheduled_end);
                    document.getElementById('endTime').innerHTML = `<option value="${endTime}" selected>${endTime}</option>`;
                    currentStartDateTime = booking.scheduled_start;
                    currentEndDateTime = booking.scheduled_end;
                }, 50);
            }, 50);
            document.getElementById('payment').focus();
        }

        function getServiceDisplayName(serviceName) {
            const thaiHints = {
                'Aroma massage': 'อโรม่า',
                'Back, Neck & shoulder': 'หลัง คอ ไหล่',
                'Back, neck & shoulder with herbal compress': 'หลัง คอ ไหล่ + ประคบ',
                'Body Scrub': 'ขัดผิว',
                'Body Scrub + oil massage': 'ขัดผิว + ออยล์',
                'Body scrub + Aroma massage': 'ขัดผิว + อโรม่า',
                'Coconut lovers - coconut oil massage': 'น้ำมันมะพร้าว',
                'Foot + Aroma Massage': 'เท้า + อโรม่า',
                'Foot + Thai Massage': 'เท้า + ไทย',
                'Foot + back, neck & shoulder': 'เท้า + หลังคอไหล่',
                'Foot + oil Massage': 'เท้า + ออยล์',
                'Foot massage': 'นวดเท้า',
                'Foot massage with herbal compress': 'นวดเท้า + ประคบ',
                'Foot spa': 'สปาเท้า',
                'Foot spa with foot massage': 'สปาเท้า + นวดเท้า',
                'Oil massage': 'ออยล์',
                'Thai Massage': 'นวดไทย',
                'Thai massage with Herbal compress': 'นวดไทย + ประคบ'
            };
            const hint = thaiHints[serviceName];
            return hint ? `${serviceName} (${hint})` : serviceName;
        }

        function getServiceThaiHint(serviceName) {
            const displayName = getServiceDisplayName(serviceName);
            const match = displayName.match(/\(([^)]+)\)$/);
            return match ? match[1] : serviceName;
        }

        const serviceCategoryDefinitions = [
            { key: 'thai', label: 'นวดไทย', sublabel: 'Thai', match: name => name.includes('thai') },
            { key: 'foot', label: 'นวดเท้า', sublabel: 'Foot', match: name => name.includes('foot') },
            { key: 'oil', label: 'ออยล์', sublabel: 'Oil', match: name => name.includes('oil') },
            { key: 'shoulder', label: 'หลัง คอ ไหล่', sublabel: 'Shoulder', match: name => name.includes('back') || name.includes('shoulder') || name.includes('neck') },
            { key: 'aroma', label: 'อโรม่า', sublabel: 'Aroma', match: name => name.includes('aroma') },
            { key: 'coconut', label: 'มะพร้าว', sublabel: 'Coconut', match: name => name.includes('coconut') },
            { key: 'scrub', label: 'ขัดผิว', sublabel: 'Scrub', match: name => name.includes('scrub') },
            { key: 'combo', label: 'คอมโบ', sublabel: 'Combo', match: () => true }
        ];

        function isComboService(serviceName) {
            const normalized = serviceName.toLowerCase();
            return normalized.includes('+') || normalized.includes(' with ');
        }

        function getServiceCategory(serviceName) {
            const normalized = serviceName.toLowerCase();
            if (isComboService(serviceName)) {
                return 'combo';
            }
            const category = serviceCategoryDefinitions.find(definition => definition.key !== 'combo' && definition.match(normalized));
            return category ? category.key : 'combo';
        }

        function sortComboServices(serviceNames) {
            const priority = ['Foot + back, neck & shoulder'];
            return [...serviceNames].sort((a, b) => {
                const aPriority = priority.indexOf(a);
                const bPriority = priority.indexOf(b);
                if (aPriority === -1 && bPriority === -1) return 0;
                if (aPriority === -1) return 1;
                if (bPriority === -1) return -1;
                return aPriority - bPriority;
            });
        }

        function getAvailableServiceNames() {
            const serviceSelect = document.getElementById('service');
            if (!serviceSelect) return [];
            return Array.from(serviceSelect.options)
                .map(option => option.value)
                .filter(Boolean);
        }

        function setActiveChoice(container, attributeName, activeValue) {
            if (!container) return;
            container.querySelectorAll('.transaction-choice-button').forEach(button => {
                const isActive = button.getAttribute(attributeName) === String(activeValue);
                button.classList.toggle('is-active', isActive);
                button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
        }

        function selectServiceValue(serviceName) {
            const serviceSelect = document.getElementById('service');
            if (!serviceSelect || !serviceName) return;
            serviceSelect.value = serviceName;
            serviceSelect.dispatchEvent(new Event('change', { bubbles: true }));
            updateServiceButtonState();
        }

        function selectDurationValue(duration) {
            const durationSelect = document.getElementById('duration');
            if (!durationSelect || !duration) return;
            durationSelect.value = duration;
            durationSelect.dispatchEvent(new Event('change', { bubbles: true }));
            updateDurationButtonState();
        }

        function renderButton(container, className, attributes, primaryLabel, secondaryLabel, onClick) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = className;
            Object.entries(attributes).forEach(([key, value]) => {
                button.setAttribute(key, value);
            });
            button.setAttribute('aria-pressed', 'false');
            const primary = document.createElement('span');
            primary.textContent = primaryLabel;
            const secondary = document.createElement('small');
            secondary.textContent = secondaryLabel;
            button.append(primary, secondary);
            button.addEventListener('click', onClick);
            container.appendChild(button);
        }

        function renderServiceButtons() {
            const categoryContainer = document.getElementById('service-category-buttons');
            const comboPanel = document.getElementById('combo-service-panel');
            const comboContainer = document.getElementById('combo-service-buttons');
            const durationPanel = document.getElementById('duration-button-panel');
            if (!categoryContainer || !comboPanel || !comboContainer) return;

            const serviceNames = getAvailableServiceNames();
            categoryContainer.innerHTML = '';
            comboContainer.innerHTML = '';
            if (durationPanel && !document.getElementById('duration').value) {
                durationPanel.innerHTML = '<div class="transaction-button-empty">เลือกบริการก่อน</div>';
            }

            const servicesByCategory = serviceNames.reduce((groups, serviceName) => {
                const category = getServiceCategory(serviceName);
                if (!groups[category]) groups[category] = [];
                groups[category].push(serviceName);
                return groups;
            }, {});

            serviceCategoryDefinitions.forEach(definition => {
                if (!servicesByCategory[definition.key]?.length) return;
                renderButton(
                    categoryContainer,
                    'transaction-choice-button transaction-category-button',
                    { 'data-service-category': definition.key },
                    definition.label,
                    definition.sublabel,
                    () => {
                        if (definition.key === 'combo') {
                            comboPanel.hidden = false;
                            setActiveChoice(categoryContainer, 'data-service-category', definition.key);
                            renderDurationButtons();
                            return;
                        }
                        comboPanel.hidden = true;
                        selectServiceValue(servicesByCategory[definition.key][0]);
                    }
                );
            });

            sortComboServices(servicesByCategory.combo || []).forEach(serviceName => {
                renderButton(
                    comboContainer,
                    'transaction-choice-button transaction-combo-button',
                    { 'data-service-value': serviceName },
                    getServiceThaiHint(serviceName),
                    serviceName,
                    () => selectServiceValue(serviceName)
                );
            });

            updateServiceButtonState();
        }

        function updateServiceButtonState() {
            const serviceSelect = document.getElementById('service');
            const categoryContainer = document.getElementById('service-category-buttons');
            const comboPanel = document.getElementById('combo-service-panel');
            const comboContainer = document.getElementById('combo-service-buttons');
            if (!serviceSelect || !categoryContainer || !comboPanel || !comboContainer) return;

            const selectedService = serviceSelect.value;
            const selectedCategory = selectedService ? getServiceCategory(selectedService) : '';
            setActiveChoice(categoryContainer, 'data-service-category', selectedCategory);
            setActiveChoice(comboContainer, 'data-service-value', selectedService);
            comboPanel.hidden = selectedCategory !== 'combo';
        }

        function renderDurationButtons() {
            const durationPanel = document.getElementById('duration-button-panel');
            const durationSelect = document.getElementById('duration');
            if (!durationPanel || !durationSelect) return;

            const durationOptions = Array.from(durationSelect.options)
                .map(option => option.value)
                .filter(Boolean);
            durationPanel.innerHTML = '';

            if (!durationOptions.length) {
                durationPanel.innerHTML = '<div class="transaction-button-empty">เลือกบริการก่อน</div>';
                return;
            }

            durationOptions.forEach(duration => {
                renderButton(
                    durationPanel,
                    'transaction-choice-button transaction-duration-button',
                    { 'data-duration-value': duration },
                    `${duration} นาที`,
                    'เวลา',
                    () => selectDurationValue(duration)
                );
            });
            updateDurationButtonState();
        }

        function updateDurationButtonState() {
            const durationPanel = document.getElementById('duration-button-panel');
            const durationSelect = document.getElementById('duration');
            if (!durationPanel || !durationSelect) return;
            setActiveChoice(durationPanel, 'data-duration-value', durationSelect.value);
        }

        function updateServiceOptions() {
            const location = document.getElementById('location').value;
            let serviceSelect = document.getElementById('service');
            let durationSelect = document.getElementById('duration');
            
            // Defensive programming: check if elements exist
            if (!serviceSelect || !durationSelect) {
                console.error('❌ updateServiceOptions: Required DOM elements not found');
                return;
            }
            
            serviceSelect.innerHTML = '<option value="">เลือกบริการ...</option>';
            durationSelect.innerHTML = '<option value="">เลือกระยะเวลา...</option>';
            timeWindowPromotionOverride = false;
            
            if (location) {
                // Find unique service names for this location
                const locationServices = CONFIG.settings.services.filter(s => s.location === location);
                const uniqueServices = [...new Set(locationServices.map(s => s.name))];
                uniqueServices.forEach(serviceName => {
                    const option = document.createElement('option');
                    option.value = serviceName;
                    option.textContent = getServiceDisplayName(serviceName);
                    serviceSelect.appendChild(option);
                });
            }
            renderServiceButtons();
            renderDurationButtons();
        }

        function updateDurationOptions() {
            const location = document.getElementById('location').value;
            const serviceName = document.getElementById('service').value;
            let durationSelect = document.getElementById('duration');
            
            // Defensive programming: check if element exists
            if (!durationSelect) {
                console.error('❌ updateDurationOptions: Duration select element not found');
                return;
            }
            
            durationSelect.innerHTML = '<option value="">เลือกระยะเวลา...</option>';
            timeWindowPromotionOverride = false;
            
            if (location && serviceName) {
                // Find all durations for this service type and location
                const serviceOptions = CONFIG.settings.services.filter(s => 
                    s.name === serviceName && s.location === location
                );
                serviceOptions.forEach(service => {
                    const option = document.createElement('option');
                    option.value = service.duration;
                    option.textContent = `${service.duration} นาที`;
                    durationSelect.appendChild(option);
                });
            }
            renderDurationButtons();
        }

        async function updatePricing() {
            const location = document.getElementById('location').value;
            const serviceName = document.getElementById('service').value;
            const duration = document.getElementById('duration').value;
            const promotionLabel = document.getElementById('time-window-promotion-label');
            const overrideButton = document.getElementById('time-window-promotion-override');

            promotionLabel.hidden = true;
            promotionLabel.textContent = '';
            overrideButton.hidden = true;
            
            if (location && serviceName && duration) {
                const service = CONFIG.settings.services.find(s => 
                    s.name === serviceName && s.duration == duration && s.location === location
                );
                
                if (service) {
                    document.getElementById('servicePrice').textContent = `฿${service.price.toFixed(2)}`;
                    currentBaseMasseuseFee = Number(service.fee);
                    const bookingFee = transactionMode === 'booking' ? 50 : 0;
                    document.getElementById('masseuseeFee').textContent = bookingFee
                        ? `฿${currentBaseMasseuseFee.toFixed(2)} + ฿${bookingFee.toFixed(2)}`
                        : `฿${currentBaseMasseuseFee.toFixed(2)}`;
                    try {
                        const quote = await api.quoteTransactionPromotion({
                            service_type: serviceName,
                            location,
                            duration: Number(duration),
                            time_window_promotion_override: timeWindowPromotionOverride
                        });
                        if (document.getElementById('service').value !== serviceName
                            || document.getElementById('duration').value !== String(duration)) return;
                        document.getElementById('servicePrice').textContent = `฿${Number(quote.finalPrice).toFixed(2)}`;
                        if (quote.promotionType) {
                            promotionLabel.textContent = quote.manualOverrideApplied
                                ? 'ใช้ราคาโปรโดยพนักงานรับรอง'
                                : 'ราคาโปรอัตโนมัติ';
                            promotionLabel.hidden = false;
                        }
                        if (quote.manualOverrideEligible && !quote.manualOverrideApplied) {
                            overrideButton.hidden = false;
                        }
                    } catch (error) {
                        console.error('Unable to quote time-window promotion:', error);
                    }
                } else {
                    currentBaseMasseuseFee = 0;
                    document.getElementById('servicePrice').textContent = '฿0.00';
                    document.getElementById('masseuseeFee').textContent = '฿0.00';
                }
            } else {
                currentBaseMasseuseFee = 0;
                document.getElementById('servicePrice').textContent = '฿0.00';
                document.getElementById('masseuseeFee').textContent = '฿0.00';
            }
        }

        function applyTimeWindowPromotionOverride() {
            timeWindowPromotionOverride = true;
            updatePricing();
        }

        function formatTime(date) {
            const hours = date.getHours();
            const minutes = date.getMinutes();
            const ampm = hours >= 12 ? 'PM' : 'AM';
            const displayHours = hours % 12 || 12;
            const displayMinutes = minutes.toString().padStart(2, '0');
            return `${displayHours}:${displayMinutes} ${ampm}`;
        }

